<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_irtcengine_stopplaybackdevicetest">
    <title><ph keyref="stopPlaybackDeviceTest"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="android">Stops audio playback device test.</ph><ph id="shortdesc" props="ios mac">Stops the audio playback device test.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="stopPlaybackDeviceTest"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="android" outputclass="language-java">public abstract int stopPlaybackDeviceTest();</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (int)stopPlaybackDeviceTest;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)stopPlaybackDeviceTest NS_SWIFT_NAME(stopPlaybackDeviceTest());</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="android">You need to call this method after calling <xref keyref="startPlaybackDeviceTest"/> to stop the test.</p>
            <note props="android">Call this method before joining a channel.</note>
        <p props="ios mac">This method stops the audio playback device test. You must call this method to stop the test after calling the <xref keyref="startPlaybackDeviceTest"/> method.</p>
            <note type="attention" props="ios mac">Call this method before joining a channel.</note>
        </section>
        <section id="return_values" props="android ios mac">
            <title>Return Values</title>
            <p props="android">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
        <ul props="ios mac">
            <li>0: Success.</li>
            <li>&lt; 0: Failure. <ph props="cn">See <xref keyref="error-code-link"/> for details and resolution suggestions.</ph></li>
            </ul> </section>
    </refbody>
</reference>
