<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="callback_imediaplayersourceobserver_onplayersourcestatechanged">
    <title><ph keyref="onPlayerSourceStateChanged"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Callback for playback state changes.</ph><ph id="shortdesc" props="android">Callback for playback state changes.</ph><ph id="shortdesc" props="ios mac">Reports the changes of playback state.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="onPlayerSourceStateChanged"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual void onPlayerSourceStateChanged(media::base::MEDIA_PLAYER_STATE state, media::base::MEDIA_PLAYER_REASON reason) = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">void onPlayerStateChanged(Constants.MediaPlayerState state, Constants.MediaPlayerReason reason);</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (void)AgoraRtcMediaPlayer:(id&lt;AgoraRtcMediaPlayerProtocol&gt; _Nonnull)playerKit
          didChangedToState:(AgoraMediaPlayerState)state
                      reason:(AgoraMediaPlayerReason)reason NS_SWIFT_NAME(AgoraRtcMediaPlayer(_:didChangedTo:reason:));</codeblock>
            </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="cpp">This callback is triggered by the SDK to report the current playback state when the media player state changes.</p>
            <p props="android">This callback is triggered by the SDK when the media player's state changes.</p>
        <p props="ios mac">When the state of the media player changes, the SDK triggers this callback to report the current playback state.</p>
        </section>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>state</pt>
                    <pd>Playback state. See <xref keyref="MEDIA_PLAYER_STATE"/>.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>reason</pt>
                    <pd>Reason for the playback state change. See <xref keyref="MEDIA_PLAYER_REASON"/>.</pd>
                </plentry>
                <plentry props="android">
                    <pt>state</pt>
                    <pd>Playback state. See <xref keyref="MEDIA_PLAYER_STATE"/>.</pd>
                </plentry>
                <plentry props="android">
                    <pt>reason</pt>
                    <pd>Reason for the playback state change. See <xref keyref="MEDIA_PLAYER_REASON"/>.</pd>
                </plentry>
            <plentry conkeyref="onPlayerEvent/playerkit" props="ios mac">
                <pt/>
                <pd/>
            </plentry>
            <plentry props="ios mac">
                <pt>state</pt>
                <pd>The playback state. See <xref keyref="MEDIA_PLAYER_STATE"/>.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt>reason</pt>
                <pd>The reason for the changes in the media player status. See <xref keyref="MEDIA_PLAYER_REASON"/>.</pd>
            </plentry>
            </parml>
        </section>
    </refbody>
</reference>
