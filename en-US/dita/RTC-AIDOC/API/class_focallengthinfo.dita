<reference id="class_focallengthinfo">
    <title><ph keyref="FocalLengthInfo"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Represents focal length information supported by the camera.</ph><ph id="shortdesc" props="android">Focal length information including camera direction and focal length type.</ph><ph id="shortdesc" props="ios mac">Focal length information supported by the camera, including the camera direction and focal length type.</ph></shortdesc>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">struct FocalLengthInfo {
  int cameraDirection;
  CAMERA_FOCAL_LENGTH_TYPE focalLengthType;
};</codeblock>
                <codeblock props="android" outputclass="language-java">public class AgoraFocalLengthInfo {
  public int cameraDirection;
  public int focalLengthType;
}</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">__attribute__((visibility("default"))) @interface AgoraFocalLengthInfo : NSObject
@property(assign, nonatomic) int cameraDirection;
@property(assign, nonatomic) AgoraFocalLength focalLengthType;
@end</codeblock>
            </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title" props="cpp">
