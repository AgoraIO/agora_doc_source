<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_rhythmplayerreason">
    <title><ph keyref="RHYTHM_PLAYER_REASON"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Virtual metronome error codes.</ph><ph id="shortdesc" props="ios mac">Virtual Metronome error message.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>RHYTHM_PLAYER_REASON_OK</pt>
                    <pd>(0): The beat file plays normally without error.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>RHYTHM_PLAYER_REASON_FAILED</pt>
                    <pd>(1): A general error occurred with no specific reason.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>RHYTHM_PLAYER_REASON_CAN_NOT_OPEN</pt>
                    <pd>(801): An error occurred while opening the beat file.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>RHYTHM_PLAYER_REASON_CAN_NOT_PLAY</pt>
                    <pd>(802): An error occurred while playing the beat file.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>RHYTHM_PLAYER_REASON_FILE_OVER_DURATION_LIMIT</pt>
                    <pd>(803): The duration of the beat file exceeds the limit. The maximum duration is 1.2 seconds.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RHYTHM_PLAYER_REASON_OK"/></pt>
                <pd>0: The beat files are played normally without errors.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RHYTHM_PLAYER_REASON_FAILED"/></pt>
                <pd>1: A general error; no specific reason.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RHYTHM_PLAYER_REASON_CAN_NOT_OPEN"/></pt>
                <pd>801: There is an error when opening the beat files.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RHYTHM_PLAYER_REASON_CAN_NOT_PLAY"/></pt>
                <pd>802: There is an error when playing the beat files.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RHYTHM_PLAYER_REASON_FILE_OVER_DURATION_LIMIT"/></pt>
                <pd>803: The duration of the beat file exceeds the limit. The maximum duration is 1.2 seconds.</pd>
            </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
</reference>
