<reference id="class_pathstats">
    <title><ph keyref="PathStats"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Retrieves statistics of a specific network path.</ph><ph id="shortdesc" props="android">Used to collect statistics for a specific network path.</ph><ph id="shortdesc" props="ios mac">Statistical information about a specific network path.</ph></shortdesc>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">struct PathStats {
  MultipathType type;
  int txKBitRate;
  int rxKBitRate;
};</codeblock>
                <codeblock props="android" outputclass="language-java">public static class PathStats {
  public int pathType;
  public int txKBitRate;
  public int rxKBitRate;
}</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">__attribute__((visibility("default"))) @interface AgoraPathStats : NSObject
@property (assign, nonatomic) AgoraMultipathType pathType;
@property (assign, nonatomic) NSUInteger txKBitRate;
@property (assign, nonatomic) NSUInteger rxKBitRate;
@end</codeblock>
            </p>
        </section>
