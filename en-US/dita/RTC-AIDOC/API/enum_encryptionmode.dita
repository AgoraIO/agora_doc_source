<reference id="enum_encryptionmode">
    <title><ph keyref="ENCRYPTION_MODE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Built-in encryption modes.</ph><ph id="shortdesc" props="android">Built-in encryption modes.</ph><ph id="shortdesc" props="ios mac">The built-in encryption mode.</ph></shortdesc>
    <refbody>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title" props="android cpp">
            <p props="cpp">Agora recommends using <codeph>AES_128_GCM2</codeph> or <codeph>AES_256_GCM2</codeph> encryption modes. These modes support salt to enhance security.</p>
            <p props="android">Agora recommends using the <codeph>AES_128_GCM2</codeph> or <codeph>AES_256_GCM2</codeph> encryption mode. These modes support setting a salt (<codeph>encryptionKdfSalt</codeph>) and provide higher security.</p>
        <p props="ios mac">Agora recommends using <ph keyref="AES_128_GCM2"/> or <ph keyref="AES_256_GCM2"/> encrypted mode. These two modes support the use of salt for higher security.</p>
        </section>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>AES_128_XTS</pt>
                    <pd>(1): 128-bit AES encryption, XTS mode.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>AES_128_ECB</pt>
                    <pd>(2): 128-bit AES encryption, ECB mode.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>AES_256_XTS</pt>
                    <pd>(3): 256-bit AES encryption, XTS mode.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>SM4_128_ECB</pt>
                    <pd>(4): 128-bit SM4 encryption, ECB mode.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>AES_128_GCM</pt>
                    <pd>(5): 128-bit AES encryption, GCM mode.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>AES_256_GCM</pt>
                    <pd>(6): 256-bit AES encryption, GCM mode.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>AES_128_GCM2</pt>
                    <pd>(7): (Default) 128-bit AES encryption, GCM mode. This mode requires setting <codeph>encryptionKdfSalt</codeph>.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>AES_256_GCM2</pt>
                    <pd>(8): 256-bit AES encryption, GCM mode. This mode requires setting <codeph>encryptionKdfSalt</codeph>.</pd>
                </plentry>
