<reference id="api_irtcengine_resumeallchannelmediarelay">
    <title><ph keyref="resumeAllChannelMediaRelay"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Resumes the media stream relay to all destination channels.</ph><ph id="shortdesc" props="android">Resumes media stream relay to all destination channels.</ph><ph id="shortdesc" props="ios mac">Resumes the media stream relay to all target channels.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="resumeAllChannelMediaRelay"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual int resumeAllChannelMediaRelay() = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">public abstract int resumeAllChannelMediaRelay();</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (int)resumeAllChannelMediaRelay;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)resumeAllChannelMediaRelay NS_SWIFT_NAME(resumeAllChannelMediaRelay());</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="android">After calling <xref keyref="pauseAllChannelMediaRelay"/>, you can call this method to resume media stream relay.</p>
            <note props="cpp">Call this method after calling the <xref keyref="pauseAllChannelMediaRelay"/> method.</note>
            <note props="android">Call this method after calling <xref keyref="pauseAllChannelMediaRelay"/>.</note>
        <p props="ios mac">After calling the <xref keyref="pauseAllChannelMediaRelay"/> method, you can call this method to resume relaying media streams to all destination channels.</p>
            <note type="attention" props="ios mac">Call this method after <xref keyref="pauseAllChannelMediaRelay"/>.</note> </section>
        <section id="return_values" props="android cpp ios mac">
            <title>Return Values</title>
            <p props="cpp">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.
                        <ul>
                            <li>-5: The call is rejected. There is no paused media stream relay across channels.</li>
                        </ul>
                    </li>
                </ul>
            </p>
            <p props="android">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.
                        <ul>
                            <li>-5: The call is rejected. No paused media stream relay found.</li>
                        </ul>
                    </li>
                </ul>
            </p>
        <ul props="ios mac">
            <li props="native unreal bp electron unity rn cs">0: Success.</li>
            <li>&lt; 0: Failure. <ph props="cn">See <xref keyref="error-code-link"/> for details and resolution suggestions.</ph><ul><li>-5: The method call was rejected. There is no paused channel media relay.</li></ul>
            </li>
            </ul> </section>
    </refbody>
