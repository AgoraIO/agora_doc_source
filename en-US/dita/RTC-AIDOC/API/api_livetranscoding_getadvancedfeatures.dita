<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_livetranscoding_getadvancedfeatures">
    <title><ph keyref="getAdvancedFeatures"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="android">Checks whether advanced features for RTMP or RTMPS streaming with transcoding are enabled.</ph><ph id="shortdesc" props="ios mac">Gets the status of the advanced features of streaming with transcoding.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="getAdvancedFeatures"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="android" outputclass="language-java">public Map&lt;String, Boolean&gt; getAdvancedFeatures()</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (NSArray&lt;AgoraLiveStreamAdvancedFeature*&gt;* _Nullable)getAdvancedFeatures;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (NSArray&lt;AgoraLiveStreamAdvancedFeature*&gt;* _Nullable)getAdvancedFeatures NS_SWIFT_NAME(getAdvancedFeatures());</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title"><p props="ios mac">If you want to enable the advanced features of streaming with transcoding, contact <xref keyref="mailto-link"/>.</p>
        </section>
        <section id="return_values" props="android ios mac">
            <title>Return Values</title>
            <p props="android">
                <ul>
                    <li>If the method call succeeds, returns a <codeph>Map</codeph> containing the name and enabled status of each advanced feature.</li>
                    <li>If the method call fails, returns an empty <codeph>Map</codeph>.</li>
                </ul>
            </p>
        <p props="ios mac"><ph props="ios mac">The feature name and whether the feature is enabled. See <xref keyref="LiveStreamAdvancedFeature"/>. </ph><ph props="android">The advanced feature names, including LBHQ (high-quality video with a lower bitrate) and VEO (optimized video encoder), and whether the feature is enabled.</ph></p>
        </section>
    </refbody>
</reference>
