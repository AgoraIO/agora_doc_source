        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <note props="cpp">This callback applies only when pushing externally encoded H.264 video data to the SDK.</note>
            <note props="android">This callback is only applicable when pushing externally encoded H.264 video data to the SDK.</note>
        <p props="ios mac">The SDK triggers this callback when the uplink network information changes.</p>
            <note type="attention" props="ios mac">This callback only applies to scenarios where you push externally encoded video data in H.264 format to the SDK.</note> </section>
        <section id="timing" deliveryTarget="details" props="android">
            <title>Trigger Timing</title>
            <p props="android">This callback is triggered when uplink network information changes.</p>
        </section>
