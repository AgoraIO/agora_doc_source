<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_qualitytype">
    <title><ph keyref="QUALITY_TYPE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Network quality type.</ph><ph id="shortdesc" props="ios mac">Network quality types.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>QUALITY_UNKNOWN</pt>
                    <pd>(0): Unknown network quality.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>QUALITY_EXCELLENT</pt>
                    <pd>(1): Excellent network quality, best call experience.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>QUALITY_GOOD</pt>
                    <pd>(2): Good network quality, smooth call experience, bitrate may be slightly lower than excellent.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>QUALITY_POOR</pt>
                    <pd>(3): Average network quality, users may notice slight degradation in call quality.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>QUALITY_BAD</pt>
                    <pd>(4): Poor network quality, users cannot have smooth calls.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>QUALITY_VBAD</pt>
                    <pd>(5): Very bad network quality, users can hardly make calls.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>QUALITY_DOWN</pt>
                    <pd>(6): Network connection is lost, users cannot make calls at all.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>QUALITY_UNSUPPORTED</pt>
                    <pd>(7): (Reserved) Unable to detect network quality.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>QUALITY_DETECTING</pt>
                    <pd>(8): Last-mile network probe test is in progress.</pd>
                </plentry>
            <plentry props="ios mac">
                    <pt><ph keyref="QUALITY_UNKNOWN"/></pt>
                    <pd>0: The network quality is unknown.</pd>
               </plentry>
               <plentry props="ios mac">
                    <pt><ph keyref="QUALITY_EXCELLENT"/></pt>
                    <pd>1: The network quality is excellent.</pd>
               </plentry>
               <plentry props="ios mac">
                    <pt><ph keyref="QUALITY_GOOD"/></pt>
                    <pd>2: The network quality is quite good, but the bitrate may be slightly lower than excellent.</pd>
               </plentry>
               <plentry props="ios mac">
                    <pt><ph keyref="QUALITY_POOR"/></pt>
                    <pd>3: Users can feel the communication is slightly impaired.</pd>
               </plentry>
               <plentry props="ios mac">
                    <pt><ph keyref="QUALITY_BAD"/></pt>
                    <pd>4: Users cannot communicate smoothly.</pd>
               </plentry>
               <plentry props="ios mac">
                    <pt><ph keyref="QUALITY_VBAD"/></pt>
                    <pd>5: The quality is so bad that users can barely communicate.</pd>
               </plentry>
               <plentry props="ios mac">
                    <pt><ph keyref="QUALITY_DOWN"/></pt>
                    <pd>6: The network is down and users cannot communicate at all.</pd>
               </plentry>
               <plentry props="ios mac">
                    <pt><ph keyref="QUALITY_UNSUPPORTED"/></pt>
                    <pd>7: Users cannot detect the network quality (not in use).</pd>
               </plentry>
               <plentry props="ios mac">
                    <pt><ph keyref="QUALITY_DETECTING"/></pt>
                    <pd>8: The last-mile network probe test is in progress.</pd>
               </plentry>
               </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
</reference>
