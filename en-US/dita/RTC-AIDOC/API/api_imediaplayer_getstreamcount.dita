<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_imediaplayer_getstreamcount">
    <title><ph keyref="getStreamCount"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Gets the number of media streams in the media resource.</ph><ph id="shortdesc" props="android">Gets the number of media streams in the media resource.</ph><ph id="shortdesc" props="ios mac">Gets the number of the media streams in the media resource.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="getStreamCount"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual int getStreamCount(int64_t&amp; count) = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">int getStreamCount();</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (NSInteger)getStreamCount;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (NSInteger)getStreamCount NS_SWIFT_NAME(getStreamCount());</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <note props="cpp">Before calling this method, call the <xref keyref="open"/> method and wait for the <xref keyref="onPlayerSourceStateChanged"/> callback to report the <codeph>PLAYER_STATE_OPEN_COMPLETED</codeph> state.</note>
            <note props="android">Before calling this method, call the <codeph>open</codeph> method and wait for the <xref keyref="onPlayerSourceStateChanged"/> callback to report the <codeph>OPEN_COMPLETED</codeph> state.</note>
        <note type="attention" id="note" props="ios mac">Call this method after you call <xref keyref="open"/> and receive the <xref keyref="onPlayerSourceStateChanged"/> callback reporting the state <apiname keyref="PLAYER_STATE_OPEN_COMPLETED"/>.</note> </section>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>count</pt>
                    <pd>Output parameter, the number of media streams in the media resource. See int64_t</pd>
                </plentry>
            <plentry props="ios mac">
                <pt>count</pt>
                <pd>An output parameter. The number of the media streams in the media resource.</pd>
            </plentry>
            </parml>
        </section>
        <section id="return_values" props="android cpp ios mac">
            <title>Return Values</title>
            <p props="cpp">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure. See <xref keyref="MEDIA_PLAYER_REASON"/>.</li>
                </ul>
            </p>
            <p props="android">
                <ul>
                    <li>If the method call succeeds, returns the number of media streams in the media resource.</li>
                    <li>&lt; 0: If the method call fails. See <xref keyref="MEDIA_PLAYER_REASON"/>.</li>
                </ul>
            </p>
        <ul props="ios mac">
            <li props="cpp unreal bp unity cs">0: Success.</li>
            <li props="android ios mac rn electron flutter">The number of the media streams in the media resource if the method call succeeds.</li>
            <li>&lt; 0: Failure. See <xref keyref="MEDIA_PLAYER_REASON"/>.</li>
            </ul> </section>
    </refbody>
</reference>
