<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_irtcengine_stopaudiodeviceloopbacktest_irtcengine">
    <title><ph keyref="stopAudioDeviceLoopbackTest_IRtcEngine"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="ios mac">Stops the audio device loopback test.</ph><ph id="shortdesc" props="ios mac">Stops the audio device loopback test.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="stopAudioDeviceLoopbackTest_IRtcEngine"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="mac" outputclass="language-objectivec">- (int)stopAudioDeviceLoopbackTest NS_SWIFT_NAME(stopAudioDeviceLoopbackTest());</codeblock>
            </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <note props="mac">
                <ul>
                    <li>You can call this method either before or after joining a channel.</li>
                    <li>This method only takes effect when called by the host.</li>
                    <li>After calling <xref keyref="startAudioDeviceLoopbackTest_IRtcEngine"/> to start the loopback test, ensure that you call this method to stop the test.</li>
                </ul>
            </note>
        </section>
        <section id="return_values" props="mac">
            <title>Return Values</title>
            <p props="ios mac">0: Success. &lt; 0: Failure.</p></section>
    </refbody>
</reference>
