            <parml>
                <plentry props="cpp">
                    <pt>soundId</pt>
                    <pd>The audio effect ID. Each audio effect file has a unique ID.</pd>
                </plentry>
                <plentry props="android">
                    <pt>soundId</pt>
                    <pd>The ID of the audio effect. Each audio effect file has a unique ID.</pd>
                </plentry>
