<reference id="api_irtcengine_resumeeffect">
    <title><ph keyref="resumeEffect"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Resumes playback of the specified audio effect.</ph><ph id="shortdesc" props="android">Resumes playback of the specified audio effect.</ph><ph id="shortdesc" props="ios mac">Resumes playing a specified audio effect.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="resumeEffect"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual int resumeEffect(int soundId) = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">public abstract int resumeEffect(int soundId);</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (int)resumeEffect:(int)soundId;
</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)resumeEffect:(int)soundId NS_SWIFT_NAME(resumeEffect(_:));</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title"/>
