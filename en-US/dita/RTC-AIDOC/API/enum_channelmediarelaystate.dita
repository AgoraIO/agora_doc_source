<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_channelmediarelaystate">
    <title><ph keyref="CHANNEL_MEDIA_RELAY_STATE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Channel media relay state codes.</ph><ph id="shortdesc" props="ios mac">The state code of the channel media relay.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>RELAY_STATE_IDLE</pt>
                    <pd>(0): Initial state. After calling <xref keyref="stopChannelMediaRelay"/> successfully, the <xref keyref="onChannelMediaRelayStateChanged"/> callback returns this state.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>RELAY_STATE_CONNECTING</pt>
                    <pd>(1): SDK is attempting to relay media stream to the destination channel.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>RELAY_STATE_RUNNING</pt>
                    <pd>(2): SDK has successfully relayed media stream to the destination channel.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>RELAY_STATE_FAILURE</pt>
                    <pd>(3): An error occurred. See <codeph>code</codeph> in the <xref keyref="onChannelMediaRelayStateChanged"/> callback.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RELAY_STATE_IDLE"/></pt>
                <pd>0: The initial state. After you successfully stop the channel media relay by calling <xref keyref="stopChannelMediaRelay"/>, the <xref keyref="onChannelMediaRelayStateChanged"/> callback returns this state.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RELAY_STATE_CONNECTING"/></pt>
                <pd>1: The SDK tries to relay the media stream to the destination channel.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RELAY_STATE_RUNNING"/></pt>
                <pd>2: The SDK successfully relays the media stream to the destination channel.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RELAY_STATE_FAILURE"/></pt>
                <pd>3: An error occurs. See <parmname>code</parmname> in <xref keyref="onChannelMediaRelayStateChanged"/> for the error code.</pd>
            </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
</reference>
