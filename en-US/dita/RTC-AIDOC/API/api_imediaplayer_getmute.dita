<reference id="api_imediaplayer_getmute">
    <title><ph keyref="getMute"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Checks whether the media resource is muted.</ph><ph id="shortdesc" props="android">Reports whether the media resource is muted.</ph><ph id="shortdesc" props="ios mac">Reports whether the media resource is muted.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="getMute"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual int getMute(bool&amp; muted) = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">boolean getMute();</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (BOOL)getMute NS_SWIFT_NAME(getMute());</codeblock>
            </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title"/>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>muted</pt>
                    <pd>Output parameter. Whether the media resource is muted:
                        <ul>
                            <li><xref keyref="true"/>: Muted.</li>
                            <li><xref keyref="false"/>: Not muted.</li>
                        </ul>
                    </pd>
                </plentry>
            <plentry props="ios mac">
                <pt props="cpp unreal bp">mute</pt>
                <pt props="unity cs">muted</pt>
                <pd>An output parameter. Whether the media file is muted:<ul id="ul_awl_4c2_3qb">
                    <li><codeph><ph keyref="true"/></codeph>: The media file is muted.</li>
                    <li><codeph><ph keyref="false"/></codeph>: The media file is not muted.</li>
                    </ul></pd>
            </plentry>
            </parml>
        </section>
        <section id="return_values" props="android cpp ios mac">
            <title>Return Values</title>
            <p props="cpp">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
            <p props="android"><xref keyref="true"/>: The media resource is muted.
<xref keyref="false"/>: The media resource is not muted.</p>
        <ul props="ios mac">
            <li><codeph><ph keyref="true"/></codeph>: Reports whether the media resource is muted.</li>
            <li><codeph><ph keyref="false"/></codeph>: Reports whether the media resource is muted.</li></ul></section>
