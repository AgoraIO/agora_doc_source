                <pd>The number of lost messages.</pd>
            </plentry>
            <plentry id="cached" props="ios mac">
                <pt>cached</pt>
                <pd>Number of incoming cached messages when the data stream is interrupted.</pd>
            </plentry>
            </parml>
        </section>
    </refbody>
