<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_irtcengine_stopalleffects">
    <title><ph keyref="stopAllEffects"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Stops playing all audio effects.</ph><ph id="shortdesc" props="android">Stops playback of all audio effects.</ph><ph id="shortdesc" props="ios mac">Stops playing all audio effects.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="stopAllEffects"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual int stopAllEffects() = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">public abstract int stopAllEffects();</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (int)stopAllEffects;
</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)stopAllEffects NS_SWIFT_NAME(stopAllEffects());</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="cpp">Call this method to stop all audio effects. To pause playback instead, call <xref keyref="pauseAllEffects"/>.</p>
            <p props="android">If you only need to pause playback, call the <xref keyref="pauseAllEffects"/> method.</p>
        <p props="ios mac">When you no longer need to play the audio effect, you can call this method to stop the playback. If you only need to pause the playback, call <xref keyref="pauseAllEffects"/>.</p>
        </section>
        <section id="timing" deliveryTarget="details" props="android cpp">
            <title>Timing</title>
            <p props="cpp">Call this method after calling <xref keyref="playEffect3"/>.</p>
            <p props="android">Call after the <codeph>playEffect</codeph> method.</p>
        </section>
        <section id="return_values" props="android cpp ios mac">
            <title>Return Values</title>
            <p props="cpp">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
            <p props="android">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
        <ul props="ios mac">
            <li>0: Success.</li>
            <li>&lt; 0: Failure. <ph props="cn">See <xref keyref="error-code-link"/> for details and resolution suggestions.</ph></li>
            </ul> </section>
    </refbody>
</reference>
