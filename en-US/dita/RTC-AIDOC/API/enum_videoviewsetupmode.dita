<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_videoviewsetupmode">
    <title><ph keyref="VIDEO_VIEW_SETUP_MODE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">View setup mode.</ph><ph id="shortdesc" props="ios mac">Setting mode of the view.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>VIDEO_VIEW_SETUP_REPLACE</pt>
                    <pd>(0): (Default) Clears all added views and replaces them with a new view.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_VIEW_SETUP_ADD</pt>
                    <pd>(1): Adds a view.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_VIEW_SETUP_REMOVE</pt>
                    <pd>(2): Removes a view.
                        <note>When you no longer need to use a view, it is recommended to remove it by setting <codeph>setupMode</codeph> to <codeph>VIDEO_VIEW_SETUP_REMOVE</codeph>, otherwise it may cause rendering resource leaks.</note>
                    </pd>
                </plentry>
            <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_VIEW_SETUP_REPLACE"/></pt>
                    <pd>0: (Default) Clear all added views and replace with a new view.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_VIEW_SETUP_ADD"/></pt>
                    <pd>1: Adds a view.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_VIEW_SETUP_REMOVE"/></pt>
                    <pd>2: Deletes a view.<note type="attention">When you no longer need to use a certain view, it is recommended to delete the view by  setting <parmname>setupMode</parmname> to <ph keyref="VIDEO_VIEW_SETUP_REMOVE"/>, otherwise it may lead to leak of rendering resources.</note></pd>
                </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
</reference>
