<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_headphoneequalizerpreset">
    <title><ph keyref="HEADPHONE_EQUALIZER_PRESET"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Preset headphone equalizer types.</ph><ph id="shortdesc" props="ios mac">Preset headphone equalizer types.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>HEADPHONE_EQUALIZER_OFF</pt>
                    <pd>(0x00000000): Disable headphone equalizer and play original audio.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>HEADPHONE_EQUALIZER_OVEREAR</pt>
                    <pd>(0x04000001): Enable equalizer suitable for over-ear headphones.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>HEADPHONE_EQUALIZER_INEAR</pt>
                    <pd>(0x04000002): Enable equalizer suitable for in-ear headphones.</pd>
                </plentry>
            <plentry props="ios mac">
                    <pt><ph keyref="HEADPHONE_EQUALIZER_OFF"/></pt>
                    <pd>The headphone equalizer is disabled, and the original audio is heard.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="HEADPHONE_EQUALIZER_OVEREAR"/></pt>
                    <pd>An equalizer is used for headphones.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="HEADPHONE_EQUALIZER_INEAR"/></pt>
                    <pd>An equalizer is used for in-ear headphones.</pd>
                </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"><dl outputclass="since"><dlentry props="ios mac">
                    <dt>Since</dt>
                    <dd>v4.0.1</dd>
                </dlentry>
            </dl></section></refbody>
</reference>
