            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>userAccount</pt>
                    <pd>The user account.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>userInfo</pt>
                    <pd>Output parameter that represents user information. See <xref keyref="UserInfo"/>.</pd>
                </plentry>
                <plentry props="android">
                    <pt>userAccount</pt>
                    <pd>The user account.</pd>
                </plentry>
                <plentry props="android">
                    <pt>userInfo</pt>
                    <pd>The <xref keyref="UserInfo"/> object identifying user information. See <xref keyref="UserInfo"/>.</pd>
                </plentry>
            <plentry props="ios mac">
