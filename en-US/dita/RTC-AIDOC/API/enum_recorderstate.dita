<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_recorderstate">
    <title><ph keyref="RecorderState"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Current recording state.</ph><ph id="shortdesc" props="ios mac">The current recording state.</ph></shortdesc>
    <refbody>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title" props="cpp">
            <dl outputclass="since">
                <dlentry props="cpp">
                    <dt>Since</dt>
                    <dd>Available since v3.5.2.</dd>
                </dlentry>
            <dlentry props="ios mac">
                    <dt>Since</dt>
                    <dd>Available since v3.5.2.</dd>
                </dlentry>
            </dl>
        </section>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>RECORDER_STATE_ERROR</pt>
                    <pd>(-1): An error occurs during recording. See <xref keyref="RecorderReasonCode"/>.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>RECORDER_STATE_START</pt>
                    <pd>(2): Start audio and video recording.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>RECORDER_STATE_STOP</pt>
                    <pd>(3): Stop audio and video recording.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RECORDER_STATE_ERROR"/></pt>
                <pd>-1: An error occurs during the recording. See <xref keyref="RecorderReasonCode"/> for the reason.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RECORDER_STATE_START"/></pt>
                <pd>2: The audio and video recording starts.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RECORDER_STATE_STOP"/></pt>
                <pd>3: The audio and video recording stops.</pd>
            </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section></refbody>
</reference>
