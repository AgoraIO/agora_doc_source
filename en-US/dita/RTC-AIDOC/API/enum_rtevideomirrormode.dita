<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_rtevideomirrormode">
    <title><ph keyref="RteVideoMirrorMode"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Video mirror mode.</ph><ph id="shortdesc" props="android">Video mirror mode.</ph><ph id="shortdesc" props="ios mac">Mirror mode.</ph></shortdesc>
    <refbody>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title" props="android">
            <dl outputclass="since">
                <dlentry props="android">
                    <dt>Since</dt>
                    <dd>Available since v4.4.0.</dd>
                </dlentry>
            <dlentry props="ios mac">
                    <dt>Since</dt>
                    <dd>v4.5.0</dd>
                </dlentry>
            </dl>
        </section>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>kRteVideoMirrorModeAuto</pt>
                    <pd>(0): The SDK decides whether to enable mirror mode.
                        <ul>
                            <li>Local view mirror mode: Enabled by default when using the front camera; disabled by default when using the rear camera.</li>
                            <li>Remote user view mirror mode: Disabled by default.</li>
                        </ul>
                    </pd>
                </plentry>
                <plentry props="cpp">
                    <pt>kRteVideoMirrorModeEnabled</pt>
                    <pd>(1): Enables mirror mode.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>kRteVideoMirrorModeDisabled</pt>
                    <pd>(2): Disables mirror mode.</pd>
                </plentry>
                <plentry props="android">
                    <pt>AUTO</pt>
                    <pd>(0): SDK decides whether to enable mirror mode.
                        <ul>
                            <li>Local video view mirror mode: enabled by default when using front camera; disabled by default when using rear camera.</li>
                            <li>Remote user view mirror mode: disabled by default.</li>
                        </ul>
                    </pd>
                </plentry>
                <plentry props="android">
                    <pt>ENABLED</pt>
                    <pd>(1): Enable mirror mode.</pd>
                </plentry>
                <plentry props="android">
                    <pt>DISABLED</pt>
                    <pd>(2): Disable mirror mode.</pd>
                </plentry>
            <plentry props="ios mac">
                    <pt><ph keyref="kRteVideoMirrorModeAuto"/></pt>
                    <pd>0: The SDK determines the mirror mode.<ul>
                    <li>For the mirror mode of the local video view: If you use a front camera, the SDK enables the mirror mode by default; if you use a rear camera, the SDK disables the mirror mode by default.</li>
                    <li>For the remote user: The mirror mode is disabled by default.</li></ul></pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="kRteVideoMirrorModeEnabled"/></pt>
                    <pd>1: Enable mirror mode.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="kRteVideoMirrorModeDisabled"/></pt>
                    <pd>2: Disable mirror mode.</pd>
                </plentry>

            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section></refbody>
</reference>
