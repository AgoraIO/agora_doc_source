<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_rtmpstreamlifecycletype">
    <title><ph keyref="RTMP_STREAM_LIFE_CYCLE_TYPE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">CDN streaming lifecycle types.</ph><ph id="shortdesc" props="ios mac">Lifecycle of the CDN live video stream.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>RTMP_STREAM_LIFE_CYCLE_BIND2CHANNEL</pt>
                    <pd>(1): Binds to the channel lifecycle. If all hosts leave the channel, CDN streaming stops after 30 seconds.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>RTMP_STREAM_LIFE_CYCLE_BIND2OWNER</pt>
                    <pd>(2): Binds to the RTMP stream owner's lifecycle. If the owner leaves the channel, CDN streaming stops immediately.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RTMP_STREAM_LIFE_CYCLE_BIND2CHANNEL"/></pt>
                <pd>Bind to the channel lifecycle. If all hosts leave the channel, the CDN live streaming stops after 30 seconds.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="RTMP_STREAM_LIFE_CYCLE_BIND2OWNER"/></pt>
                <pd>Bind to the owner of the RTMP stream. If the owner leaves the channel, the CDN live streaming stops immediately.</pd>
            </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"><dl outputclass="since"><dlentry props="ios mac">
                <dt>Deprecated</dt>
                <dd/>
            </dlentry>
            </dl></section></refbody>
</reference>
