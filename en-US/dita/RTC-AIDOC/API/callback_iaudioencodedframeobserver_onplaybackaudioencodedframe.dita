<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="callback_iaudioencodedframeobserver_onplaybackaudioencodedframe">
    <title><ph keyref="onPlaybackAudioEncodedFrame"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Callback for retrieving encoded audio data of all remote users.</ph><ph id="shortdesc" props="android">Callback for retrieving encoded audio data of all remote users.</ph><ph id="shortdesc" props="ios mac">Gets the encoded audio data of all remote users.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="onPlaybackAudioEncodedFrame"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual void onPlaybackAudioEncodedFrame(const uint8_t* frameBuffer, int length, const EncodedAudioFrameInfo&amp; audioEncodedFrameInfo) = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">public abstract void onPlaybackAudioEncodedFrame(ByteBuffer buffer, int samplesPerChannel, int channels, int samplesPerSec, int codecType);</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (void)onPlaybackEncodedAudioFrame:(NSData* _Nonnull)frameData info:(AgoraEncodedAudioFrameInfo* _Nonnull) info;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (void)onPlaybackEncodedAudioFrame:(NSData* _Nonnull)frameData info:(AgoraEncodedAudioFrameInfo* _Nonnull)info NS_SWIFT_NAME(onPlaybackEncodedAudioFrame(_:info:));</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="cpp">After calling <xref keyref="registerAudioEncodedFrameObserver"/> and setting the encoded audio position to <codeph>AUDIO_ENCODED_FRAME_OBSERVER_POSITION_PLAYBACK</codeph>, you can use this callback to get the encoded audio data of all remote users.</p>
            <p props="android">After calling <xref keyref="registerAudioEncodedFrameObserver"/> and setting the encoded audio to <codeph>AUDIO_ENCODED_FRAME_OBSERVER_POSITION_PLAYBACK</codeph>, you can use this callback to retrieve encoded audio data of all remote users.</p>
        <p props="ios mac">After calling <xref keyref="registerAudioEncodedFrameObserver"/> and setting the encoded audio as <ph keyref="AUDIO_ENCODED_FRAME_OBSERVER_POSITION_PLAYBACK"/>, you can get encoded audio data of all remote users through this callback.</p>
        </section>
        <section id="timing" deliveryTarget="details" props="android">
            <title>Trigger Timing</title>
            <p props="android">This callback is triggered when encoded audio data of remote users is received.</p>
        </section>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>frameBuffer</pt>
                    <pd>Audio data buffer.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>length</pt>
                    <pd>Length of the audio data in bytes.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>audioEncodedFrameInfo</pt>
                    <pd>Information about the encoded audio frame. See <xref keyref="EncodedAudioFrameInfo"/>.</pd>
                </plentry>
                <plentry props="android">
                    <pt>buffer</pt>
                    <pd>Audio buffer.</pd>
                </plentry>
                <plentry props="android">
                    <pt>samplesPerChannel</pt>
                    <pd>Number of samples per channel.</pd>
                </plentry>
                <plentry props="android">
                    <pt>channels</pt>
                    <pd>Number of channels:
                        <ul>
                            <li>1: Mono.</li>
                            <li>2: Stereo. If stereo, the data is interleaved.</li>
                        </ul>
                    </pd>
                </plentry>
                <plentry props="android">
                    <pt>samplesPerSec</pt>
                    <pd>Recording sample rate (Hz).</pd>
                </plentry>
                <plentry props="android">
                    <pt>codecType</pt>
                    <pd>Audio codec type:
                        <ul>
                            <li><codeph>1</codeph>: OPUS.</li>
                            <li><codeph>8</codeph>: LC-AAC.</li>
                            <li><codeph>9</codeph>: HE-AAC.</li>
                            <li><codeph>11</codeph>: HE-AAC v2.</li>
                        </ul>
                    </pd>
                </plentry>
            <plentry props="ios mac">
                    <pt>frameBuffer</pt>
                    <pd>Audio data buffer.</pd></plentry>
                <plentry props="ios mac">
                    <pt>length</pt>
                    <pd>Length of the audio data in bytes.</pd></plentry>
                <plentry props="ios mac">
                    <pt>audioEncodedFrameInfo</pt>
                    <pd>Information about the encoded audio frame. See .</pd></plentry>
                <plentry props="ios mac">
                    <pt>frameData</pt>
                    <pd>Audio buffer.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt>info</pt>
                    <pd>Information about the encoded audio. See <xref keyref="EncodedAudioFrameInfo"/>.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt>buffer</pt>
                    <pd>Audio buffer.</pd></plentry>
                <plentry props="ios mac">
                    <pt>samplesPerChannel</pt>
                    <pd>Number of samples per channel.</pd></plentry>
                <plentry props="ios mac">
                    <pt>channels</pt>
                    <pd>Number of channels:

                            1: Mono.
                            2: Stereo. If stereo, the data is interleaved.</pd></plentry>
                <plentry props="ios mac">
                    <pt>samplesPerSec</pt>
                    <pd>Recording sample rate (Hz).</pd></plentry>
                <plentry props="ios mac">
                    <pt>codecType</pt>
                    <pd>Audio codec type:

                            1: OPUS.
                            8: LC-AAC.
                            9: HE-AAC.
                            11: HE-AAC v2.</pd></plentry>
                </parml>
        </section>
    </refbody>
</reference>
