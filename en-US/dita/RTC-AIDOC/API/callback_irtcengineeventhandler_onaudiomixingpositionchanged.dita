<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="callback_irtcengineeventhandler_onaudiomixingpositionchanged">
    <title><ph keyref="onAudioMixingPositionChanged"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Callback that reports the playback progress of the music file.</ph><ph id="shortdesc" props="android">Callback for music file playback progress.</ph><ph id="shortdesc" props="ios mac">Reports the playback progress of a music file.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="onAudioMixingPositionChanged"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual void onAudioMixingPositionChanged(int64_t position) {}</codeblock>
                <codeblock props="android" outputclass="language-java">public void onAudioMixingPositionChanged(long position)</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (void)rtcEngine:(AgoraRtcEngineKit *_Nonnull)engine audioMixingPositionChanged:(NSInteger)position NS_SWIFT_NAME(rtcEngine(_:audioMixingPositionChanged:));</codeblock>
            </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="cpp">After calling <codeph>startAudioMixing</codeph> to play a music file, the SDK triggers this callback every two seconds to report the playback progress.</p>
            <p props="android">After calling the <codeph>startAudioMixing</codeph> method to play a music file, the SDK triggers this callback every two seconds to report the playback progress of the music file.</p>
        <dl outputclass="since"><dlentry props="ios mac">
                <dt>Since</dt>
                <dd>v4.2.0</dd>
            </dlentry>
            </dl><p props="ios mac">After you called the <xref keyref="startAudioMixing2"/> method to play a music file, the SDK triggers this callback every two seconds to report the playback progress.</p>
        </section>
        <section id="timing" deliveryTarget="details" props="android">
            <title>Trigger Timing</title>
            <p props="android">This callback is triggered every two seconds after calling <codeph>startAudioMixing</codeph> to play the music file.</p>
        </section>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>position</pt>
                    <pd>Playback progress in milliseconds.</pd>
                </plentry>
                <plentry props="android">
                    <pt>position</pt>
                    <pd>Playback progress in milliseconds.</pd>
                </plentry>
            <plentry conkeyref="onJoinChannelSuccess/engine" props="ios mac">
                <pt/>
                <pd/>
            </plentry>
            <plentry props="ios mac">
                <pt>position</pt>
                <pd>The playback progress (ms).</pd>
            </plentry>
            </parml>
        </section>
        <section id="return_values" props="cpp ios mac">
            <title>Return Values</title>
            <p props="cpp">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
        <ul props="ios mac">
            <li>0: Success.</li>
            <li>&lt; 0: Failure. <ph props="cn">See <xref keyref="error-code-link"/> for details and resolution suggestions.</ph></li>
            </ul> </section>
    </refbody>
</reference>
