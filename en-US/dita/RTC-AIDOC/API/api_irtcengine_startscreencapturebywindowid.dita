<reference id="api_irtcengine_startscreencapturebywindowid">
    <title><ph keyref="startScreenCaptureByWindowId"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Captures the entire or part of a window by specifying the window ID.</ph><ph id="shortdesc" props="ios mac">Captures the whole or part of a window by specifying the window ID.</ph></shortdesc>
