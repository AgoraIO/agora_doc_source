                <plentry props="cpp">
                    <pt>uid</pt>
                    <pd>The ID of the remote user who sent the data stream.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>streamId</pt>
                    <pd>The ID of the received data stream.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>data</pt>
                    <pd>The content of the received data.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>length</pt>
                    <pd>The length of the received data in bytes.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>sentTs</pt>
                    <pd>The timestamp when the data stream was sent.</pd>
                </plentry>
                <plentry props="android">
                    <pt>uid</pt>
                    <pd>The remote user ID who sent the message.</pd>
                </plentry>
                <plentry props="android">
                    <pt>streamId</pt>
                    <pd>The stream ID of the received message.</pd>
                </plentry>
                <plentry props="android">
                    <pt>data</pt>
                    <pd>The received data content.</pd>
                </plentry>
            <plentry conkeyref="onJoinChannelSuccess/engine" props="ios mac">
                <pt/>
