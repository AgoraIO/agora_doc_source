<reference id="enum_experiencequalitytype">
    <title><ph keyref="EXPERIENCE_QUALITY_TYPE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Experience quality when the local user receives remote audio streams.</ph><ph id="shortdesc" props="ios mac">The Quality of Experience (QoE) of the local user when receiving a remote audio stream.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>EXPERIENCE_QUALITY_GOOD</pt>
                    <pd>(0): Good experience quality for the local user.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>EXPERIENCE_QUALITY_BAD</pt>
                    <pd>(1): Poor experience quality for the local user.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="EXPERIENCE_QUALITY_GOOD"/></pt>
                <pd>0: The QoE of the local user is good.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="EXPERIENCE_QUALITY_BAD"/></pt>
                <pd>1: The QoE of the local user is poor.</pd>
            </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
