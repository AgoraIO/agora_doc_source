    <shortdesc id="short"><ph id="shortdesc" props="cpp">Callback for local audio statistics.</ph><ph id="shortdesc" props="android">Callback for local audio stream statistics.</ph><ph id="shortdesc" props="ios mac">Reports the statistics of the local audio stream.</ph></shortdesc>
