<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_imediaplayer_setplaybackspeed">
    <title><ph keyref="setPlaybackSpeed"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Sets the playback speed of the current audio file.</ph><ph id="shortdesc" props="android">Sets the playback speed of the current audio file.</ph><ph id="shortdesc" props="ios mac">Sets the channel mode of the current audio file.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="setPlaybackSpeed"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual int setPlaybackSpeed(int speed) = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">int setPlaybackSpeed(int speed);</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (int)setPlaybackSpeed:(int)speed;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)setPlaybackSpeed:(int)speed NS_SWIFT_NAME(setPlaybackSpeed(_:));</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="cpp">You need to call the <xref keyref="open"/> method before calling this method.</p>
            <p props="android">Before calling this method, you need to call the <codeph>open</codeph> method.</p>
        <p props="ios mac">Call this method after calling <xref keyref="open"/>.</p>
        </section>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>speed</pt>
                    <pd>Playback speed. It is recommended to set a value between 30 and 400, defined as:
                        <ul>
                            <li>30: 0.3x the original speed.</li>
                            <li>100: Original speed.</li>
                            <li>400: 4x the original speed.</li>
                        </ul>
                    </pd>
                </plentry>
                <plentry props="android">
                    <pt>speed</pt>
                    <pd>Playback speed. It is recommended to set a value between 30 and 400, as follows:
                        <ul>
                            <li>30: 0.3x the original speed.</li>
                            <li>100: Original speed.</li>
                            <li>400: 4x the original speed.</li>
                        </ul>
                    </pd>
                </plentry>
            <plentry props="ios mac">
                <pt>speed</pt>
                <pd>The playback speed. Agora recommends that you set this to a value between 30 and 400, defined as follows:<ul>
                    <li>30: 0.3 times the original speed.</li>
                    <li>100: The original speed.</li>
                    <li>400: 4 times the original speed.</li>
                    </ul></pd>
            </plentry>
            </parml>
        </section>
        <section id="return_values" props="android cpp ios mac">
            <title>Return Values</title>
            <p props="cpp">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
            <p props="android">
                <ul>
                    <li>0: The method call succeeds.</li>
                    <li>&lt; 0: The method call fails.</li>
                </ul>
            </p>
        <ul props="ios mac">
            <li>0: Success.</li>
            <li>&lt; 0: Failure. <ph props="cn">See <xref keyref="error-code-link"/> for details and resolution suggestions.</ph></li>
            </ul> </section>
    </refbody>
</reference>
