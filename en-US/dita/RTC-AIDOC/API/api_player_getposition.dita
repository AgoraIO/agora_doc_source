                <codeblock props="cpp" outputclass="language-cpp">uint64_t GetPosition(Error *err = nullptr)</codeblock>
                <codeblock props="android" outputclass="language-java">public long getPosition() throws RteException</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (uint64_t)getPosition:(AgoraRteError * _Nullable)error;</codeblock>
