        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>err</pt>
                    <pd>Output parameter, status or error information. See <xref keyref="Error"/>.
                        <ul>
                            <li><codeph>kRteOk</codeph>: Call succeeds.</li>
                            <li><codeph>kRteErrorInvalidOperation</codeph>:
                                <ul>
                                    <li>The corresponding internal <xref keyref="Player_Player"/> object has been destroyed or is invalid.</li>
                                    <li>The opened URL is an RTE URL, <xref keyref="GetPosition"/> is not supported.</li>
                                </ul>
                            </li>
                        </ul>
                    </pd>
                </plentry>
            <plentry props="ios mac">
                    <pt>err</pt>
                    <pd>Output parameter, status or error information. See .

                            kRteOk: Call succeeds.
                            kRteErrorInvalidOperation:

                                    The corresponding internal  object has been destroyed or is invalid.
                                    The opened URL is an RTE URL,  is not supported.</pd></plentry>
                <plentry props="ios mac">
                    <pt>error</pt>
                    <pd>Output parameter indicating error information. Possible return values include:<ul>
                            <li><codeph>AgoraRteOk</codeph>: The call succeeds.</li>
                            <li><codeph>AgoraRteErrorInvalidOperation</codeph>:
                                <ul>
                                    <li>The corresponding internal <xref keyref="Player"/> object has been destroyed or is invalid.</li>
                                    <li>The opened URL is an RTE URL and does not support calling <xref keyref="GetPosition"/>. See <xref keyref="Error"/>.</li>
                                </ul>
                            </li>
                        </ul>
                    </pd>
                </plentry>
