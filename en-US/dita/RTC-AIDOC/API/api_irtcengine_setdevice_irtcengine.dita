<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_irtcengine_setdevice_irtcengine">
    <title><ph keyref="setDevice_IRtcEngine"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="ios mac">Specifies a device by device ID.</ph><ph id="shortdesc" props="ios mac">Specifies a device by device ID.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="setDevice_IRtcEngine"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="mac" outputclass="language-objectivec">- (int)setDevice:(AgoraMediaDeviceType)type deviceId:(NSString * _Nonnull)deviceId NS_SWIFT_NAME(setDevice(_:deviceId:));</codeblock>
            </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title"/>
        <section id="parameters" deliveryTarget="details" props="mac ios">
            <title>Parameters</title>
            <parml>
                <plentry props="mac">
                    <pt>type</pt>
                    <pd>The device type, including audio capture, audio playback, video capture, or video playback device. See AgoraMediaDeviceType.</pd></plentry>
                <plentry props="mac">
                    <pt>deviceId</pt>
                    <pd>The device ID. You can call enumerateDevices: to get the device ID. Connecting or disconnecting an audio device does not change this value.</pd></plentry>
            <plentry props="ios mac">
                    <pt>type</pt>
                    <pd>The device type, including audio capture, audio playback, video capture, or video playback device. See AgoraMediaDeviceType.</pd></plentry>
                <plentry props="ios mac">
                    <pt>deviceId</pt>
                    <pd>The device ID. You can call enumerateDevices: to get the device ID. Connecting or disconnecting an audio device does not change this value.</pd></plentry>
            </parml>
        </section>
        <section id="return_values" props="mac">
            <title>Return Values</title>
            <p props="ios mac">0: Success. &lt; 0: Failure.</p></section>
    </refbody>
</reference>
