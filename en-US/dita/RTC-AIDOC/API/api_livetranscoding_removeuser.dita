<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_livetranscoding_removeuser">
    <title><ph keyref="removeUser"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="android">Removes the specified user from the CDN stream.</ph><ph id="shortdesc" props="ios mac">Removes a user from video mixing during the CDN live streaming.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="removeUser"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="android" outputclass="language-java">public int removeUser(int uid)</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (int)removeUser:(NSUInteger)uid;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)removeUser:(NSUInteger)uid NS_SWIFT_NAME(removeUser(_:));</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title"/>
        <section id="parameters" deliveryTarget="details" props="android ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="android">
                    <pt>uid</pt>
                    <pd>The user ID to remove from the CDN stream.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt>uid</pt>
                <pd>The ID of the user to be removed.</pd>
            </plentry>
            </parml>
        </section>
        <section id="return_values" props="android ios mac">
            <title>Return Values</title>
            <p props="android">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
        <ul props="ios mac">
            <li>0: Success.</li>
            <li>&lt; 0: Failure.</li>
            </ul> </section>
    </refbody>
</reference>
