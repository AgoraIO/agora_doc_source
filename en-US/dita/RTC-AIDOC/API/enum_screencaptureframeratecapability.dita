<reference id="enum_screencaptureframeratecapability">
    <title><ph keyref="SCREEN_CAPTURE_FRAMERATE_CAPABILITY"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Maximum frame rate supported by screen sharing device.</ph><ph id="shortdesc" props="ios mac">The highest frame rate supported by the screen sharing device.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>SCREEN_CAPTURE_FRAMERATE_CAPABILITY_15_FPS</pt>
                    <pd>(0): Device supports up to 15 fps.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>SCREEN_CAPTURE_FRAMERATE_CAPABILITY_30_FPS</pt>
                    <pd>(1): Device supports up to 30 fps.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>SCREEN_CAPTURE_FRAMERATE_CAPABILITY_60_FPS</pt>
                    <pd>(2): Device supports up to 60 fps.</pd>
                </plentry>
            <plentry props="ios mac">
                    <pt><ph keyref="SCREEN_CAPTURE_FRAMERATE_CAPABILITY_15_FPS"/></pt>
                    <pd>0: The device supports the frame rate of up to 15 fps.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="SCREEN_CAPTURE_FRAMERATE_CAPABILITY_30_FPS"/></pt>
                    <pd>1: The device supports the frame rate of up to 30 fps.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="SCREEN_CAPTURE_FRAMERATE_CAPABILITY_60_FPS"/></pt>
                    <pd>2: The device supports the frame rate of up to 60 fps.</pd>
                </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"><dl outputclass="since"><dlentry props="ios mac">
