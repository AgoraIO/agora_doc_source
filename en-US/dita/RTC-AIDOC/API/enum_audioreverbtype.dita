<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_audioreverbtype">
    <title><ph keyref="AUDIO_REVERB_TYPE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Audio reverb types.</ph><ph id="shortdesc" props="android">Audio reverb types.</ph><ph id="shortdesc" props="ios mac">Audio reverberation types.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>AUDIO_REVERB_DRY_LEVEL</pt>
                    <pd>(0): Dry signal level in dB. Value range: -20 to 10.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>AUDIO_REVERB_WET_LEVEL</pt>
                    <pd>(1): Wet signal (early reflection) level in dB. Value range: -20 to 10.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>AUDIO_REVERB_ROOM_SIZE</pt>
                    <pd>(2): Size of the reflection room. Value range: 0 to 100.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>AUDIO_REVERB_WET_DELAY</pt>
                    <pd>(3): Initial delay of the wet signal in milliseconds. Value range: 0 to 200.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>AUDIO_REVERB_STRENGTH</pt>
                    <pd>(4): Reverb strength. Value range: 0 to 100.</pd>
                </plentry>
                <plentry props="android">
                    <pt>AUDIO_REVERB_DRY_LEVEL</pt>
                    <pd>(0): Level of the dry signal in dB, ranging from -20 to 10.</pd>
                </plentry>
                <plentry props="android">
                    <pt>AUDIO_REVERB_WET_LEVEL</pt>
                    <pd>(1): Level of the early reflections (wet signal) in dB, ranging from -20 to 10.</pd>
                </plentry>
                <plentry props="android">
                    <pt>AUDIO_REVERB_ROOM_SIZE</pt>
                    <pd>(2): Size of the reflection room, ranging from 0 to 100.</pd>
                </plentry>
                <plentry props="android">
                    <pt>AUDIO_REVERB_WET_DELAY</pt>
                    <pd>(3): Initial delay of the wet signal in milliseconds, ranging from 0 to 200.</pd>
                </plentry>
                <plentry props="android">
                    <pt>AUDIO_REVERB_STRENGTH</pt>
                    <pd>(4): Reverb strength, ranging from 0 to 100.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="AUDIO_REVERB_DRY_LEVEL"/></pt>
                <pd>0: The level of the dry signal (dB). The value is between -20 and 10.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="AUDIO_REVERB_WET_LEVEL"/></pt>
                <pd>1: The level of the early reflection signal (wet signal) (dB). The value is between -20 and 10.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="AUDIO_REVERB_ROOM_SIZE"/></pt>
                <pd>2: The room size of the reflection. The value is between 0 and 100.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="AUDIO_REVERB_WET_DELAY"/></pt>
                <pd>3: The length of the initial delay of the wet signal (ms). The value is between 0 and 200.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="AUDIO_REVERB_STRENGTH"/></pt>
                <pd>4: The reverberation strength. The value is between 0 and 100.</pd>
            </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
</reference>
