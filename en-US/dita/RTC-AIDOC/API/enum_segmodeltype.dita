<reference id="enum_segmodeltype">
    <title><ph keyref="SEG_MODEL_TYPE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Algorithm type used for background processing.</ph><ph id="shortdesc" props="ios mac">The type of algorithms to user for background processing.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>SEG_MODEL_AI</pt>
                    <pd>(1): (Default) Uses an algorithm suitable for all scenarios.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>SEG_MODEL_GREEN</pt>
                    <pd>(2): Uses an algorithm specifically designed for green screen background scenarios.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="SEG_MODEL_AI"/></pt>
                <pd>1: (Default) Use the algorithm suitable for all scenarios.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="SEG_MODEL_GREEN"/></pt>
                <pd>2: Use the algorithm designed specifically for scenarios with a green screen background.</pd>
            </plentry>
            </parml>
        </section>
