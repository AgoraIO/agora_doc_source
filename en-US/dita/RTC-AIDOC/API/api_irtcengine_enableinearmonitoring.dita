<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_irtcengine_enableinearmonitoring">
    <title><ph keyref="enableInEarMonitoring"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="android">Enables or disables in-ear monitoring.</ph><ph id="shortdesc" props="ios mac">Enables in-ear monitoring.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="enableInEarMonitoring"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="android" outputclass="language-java">public abstract int enableInEarMonitoring(boolean enabled);</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (int)enableInEarMonitoring:(BOOL)enabled;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)enableInEarMonitoring:(BOOL)enabled NS_SWIFT_NAME(enable(inEarMonitoring:));</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <note props="android">You must use a wired or Bluetooth headset to hear the in-ear monitoring effect.</note>
        <dl outputclass="since"><dlentry props="ios mac">
                    <dt>Since</dt>
                    <dd>v4.0.1</dd>
                </dlentry>
            </dl><p conkeyref="enableInEarMonitoring2/desc" props="ios mac"/>
        </section>
        <section id="timing" deliveryTarget="details" props="android">
            <title>Timing</title>
            <p props="android">You can call this method before or after joining a channel.</p>
        </section>
        <section id="parameters" deliveryTarget="details" props="android ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="android">
                    <pt>enabled</pt>
                    <pd>Whether to enable in-ear monitoring (default is <xref keyref="false"/>):
                        <ul>
                            <li><xref keyref="true"/>: Enable in-ear monitoring.</li>
                            <li><xref keyref="false"/>: Disable in-ear monitoring.</li>
                        </ul>
                    </pd>
                </plentry>
            <plentry conkeyref="enableInEarMonitoring2/enabled" props="ios mac">
                <pt/>
                <pd/>
            </plentry>
            </parml>
        </section>
        <section id="return_values" props="android ios mac">
            <title>Return Values</title>
            <p props="android">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.
                        <ul>
                            <li>-8: Please ensure the current audio route is Bluetooth or wired headset.</li>
                        </ul>
                    </li>
                </ul>
            </p>
        <ul props="ios mac">
                <li>0: Success.</li>
                <li>&lt; 0: Failure. <ph props="cn">See <xref keyref="error-code-link"/> for details and resolution suggestions.</ph><ul><li>- 8: Make sure the current audio routing is Bluetooth or headset.</li></ul></li></ul>
            </section>
    </refbody>
</reference>
