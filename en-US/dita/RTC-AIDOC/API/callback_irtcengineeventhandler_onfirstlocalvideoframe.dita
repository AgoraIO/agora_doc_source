<reference id="callback_irtcengineeventhandler_onfirstlocalvideoframe">
    <title><ph keyref="onFirstLocalVideoFrame"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Callback triggered when the first local video frame is displayed in the local view.</ph><ph id="shortdesc" props="android">Callback triggered when the first local video frame is displayed in the local view.</ph><ph id="shortdesc" props="ios mac">Occurs when the first local video frame is displayed on the local video view.</ph></shortdesc>
