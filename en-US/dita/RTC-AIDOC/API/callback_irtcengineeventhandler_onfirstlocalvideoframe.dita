                </plentry>
                <plentry props="cpp">
                    <pt>elapsed</pt>
                    <pd>Time elapsed (ms) from calling <codeph>joinChannel</codeph> to this callback. If <codeph>startPreview</codeph> was called before joining the channel, this is the time from <codeph>startPreview</codeph> to this event.</pd>
                </plentry>
                <plentry props="android">
                    <pt>source</pt>
