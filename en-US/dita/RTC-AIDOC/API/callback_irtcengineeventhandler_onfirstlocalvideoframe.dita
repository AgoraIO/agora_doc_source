            <p props="cpp">Triggered when the first local video frame is displayed in the local view.</p>
        </section>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>source</pt>
                    <pd>Video source type. See <xref keyref="VIDEO_SOURCE_TYPE"/>.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>width</pt>
                    <pd>Width of the first local video frame in pixels.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>height</pt>
