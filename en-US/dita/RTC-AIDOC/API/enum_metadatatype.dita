<reference id="enum_metadatatype">
    <title><ph keyref="METADATA_TYPE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Metadata types for observer.</ph><ph id="shortdesc" props="ios mac">observer. We only support video metadata for now.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>UNKNOWN_METADATA</pt>
                    <pd>(-1): Unknown metadata type.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_METADATA</pt>
                    <pd>(0): Video metadata type.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="UNKNOWN_METADATA"/></pt>
                <pd>-1: The type of metadata is unknown.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="VIDEO_METADATA"/></pt>
                <pd>0: The type of metadata is video.</pd>
            </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
