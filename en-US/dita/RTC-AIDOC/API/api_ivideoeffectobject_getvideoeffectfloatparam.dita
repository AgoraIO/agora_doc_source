<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_ivideoeffectobject_getvideoeffectfloatparam">
    <title><ph keyref="getVideoEffectFloatParam"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Retrieves the value of a specified <codeph>float</codeph> type parameter from the video effect.</ph><ph id="shortdesc" props="android">Retrieves the <codeph>float</codeph> value of the specified parameter in the video effect.</ph><ph id="shortdesc" props="ios mac">Retrieves float type parameters in video effects.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="getVideoEffectFloatParam"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual float getVideoEffectFloatParam(const char* option, const char* key) = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">float getVideoEffectFloatParam(String option, String key);</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (float)getVideoEffectFloatParamWithOption:(NSString *)option key:(NSString *)key NS_SWIFT_NAME(getVideoEffectFloatParam(option:key:));</codeblock>
            </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <dl outputclass="since">
                <dlentry props="cpp">
                    <dt>Since</dt>
                    <dd>Available since v4.6.0.</dd>
                </dlentry>
                <dlentry props="android">
                    <dt>Since</dt>
                    <dd>Available since v4.6.0.</dd>
                </dlentry>
            <dlentry props="ios mac">
                <dt>Since:</dt>
                <dd props="native">Available since v4.6.0.</dd>
                </dlentry>
            </dl>
        <p props="ios mac">Used to retrieve the value of a <codeph>float</codeph> type parameter corresponding to the specified option and key in video effects.</p>
            </section>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>option</pt>
                    <pd>Category of the parameter option.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>key</pt>
                    <pd>Key name of the parameter.</pd>
                </plentry>
                <plentry props="android">
                    <pt>option</pt>
                    <pd>Identifier of the parameter category.</pd>
                </plentry>
                <plentry props="android">
                    <pt>key</pt>
                    <pd>Key name of the parameter.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt props="android cpp">option</pt>
                <pt props="apple">option</pt>
                <pd props="android">The identifier of the parameter category.</pd>
                <pd props="apple">The category of the parameter option.</pd>
                <pd props="cpp">The category of the option to which the parameter belongs.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt props="native">key</pt>
                <pd props="native">The key name of the parameter.</pd>
            </plentry>
            </parml>
        </section>
        <section id="return_values" props="android cpp ios mac">
            <title>Return Values</title>
            <p props="cpp">
                <ul>
                    <li>If the parameter exists, returns the corresponding <codeph>float</codeph> value.</li>
                    <li>If the parameter does not exist or an error occurs, returns 0.0f.</li>
                </ul>
            </p>
            <p props="android">
                <ul>
                    <li>If the method call succeeds, returns the current <codeph>float</codeph> value.</li>
                    <li>If the method call fails, returns 0.0f.</li>
                </ul>
            </p>
        <p props="ios mac"><ul>
                        <li>If the parameter exists, returns the corresponding float value.</li>
                        <li>If the parameter does not exist or an error occurs, returns 0.0f.</li>
                        </ul>
                    </p>
        </section>
    </refbody>
