<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_localaudiostreamstate">
    <title><ph keyref="LOCAL_AUDIO_STREAM_STATE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Local audio state.</ph><ph id="shortdesc" props="ios mac">The state of the local audio.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>LOCAL_AUDIO_STREAM_STATE_STOPPED</pt>
                    <pd>(0): The local audio is in the initial state.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>LOCAL_AUDIO_STREAM_STATE_RECORDING</pt>
                    <pd>(1): The local audio capture device has been successfully started.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>LOCAL_AUDIO_STREAM_STATE_ENCODING</pt>
                    <pd>(2): The first audio frame has been successfully encoded.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>LOCAL_AUDIO_STREAM_STATE_FAILED</pt>
                    <pd>(3): Failed to start local audio.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="LOCAL_AUDIO_STREAM_STATE_STOPPED"/></pt>
                <pd>0: The local audio is in the initial state.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="LOCAL_AUDIO_STREAM_STATE_RECORDING"/></pt>
                <pd>1: The local audio capturing device starts successfully.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="LOCAL_AUDIO_STREAM_STATE_ENCODING"/></pt>
                <pd>2: The first audio frame encodes successfully.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="LOCAL_AUDIO_STREAM_STATE_FAILED"/></pt>
                <pd>3: The local audio fails to start.</pd>
            </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
</reference>
