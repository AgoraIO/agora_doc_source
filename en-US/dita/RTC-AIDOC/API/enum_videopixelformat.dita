<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_videopixelformat">
    <title><ph keyref="VIDEO_PIXEL_FORMAT"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Video pixel format.</ph><ph id="shortdesc" props="ios mac">The video pixel format.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>VIDEO_PIXEL_DEFAULT</pt>
                    <pd>(0): Default format, original video pixel format.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_PIXEL_I420</pt>
                    <pd>(1): I420 pixel format.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_PIXEL_BGRA</pt>
                    <pd>(2): BGRA pixel format.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_PIXEL_NV21</pt>
                    <pd>(3): NV21 pixel format.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_PIXEL_RGBA</pt>
                    <pd>(4): RGBA pixel format.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_PIXEL_NV12</pt>
                    <pd>(8): NV12 pixel format.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_TEXTURE_2D</pt>
                    <pd>(10): <codeph>GL_TEXTURE_2D</codeph> texture format.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_TEXTURE_OES</pt>
                    <pd>(11): <codeph>GL_TEXTURE_OES</codeph> texture format.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_CVPIXEL_NV12</pt>
                    <pd>(12): NV12 pixel format of <codeph>CVPixelBuffer</codeph> on iOS platform.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_CVPIXEL_I420</pt>
                    <pd>(13): I420 pixel format of <codeph>CVPixelBuffer</codeph> on iOS platform.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_CVPIXEL_BGRA</pt>
                    <pd>(14): BGRA pixel format of <codeph>CVPixelBuffer</codeph> on iOS platform.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_CVPIXEL_P010</pt>
                    <pd>(15): P010 pixel format (10bit NV12) of <codeph>CVPixelBuffer</codeph> on iOS platform.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_PIXEL_I422</pt>
                    <pd>(16): I422 pixel format.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_TEXTURE_ID3D11TEXTURE2D</pt>
                    <pd>(17): <codeph>ID3D11TEXTURE2D</codeph> texture format. Currently supported types include <codeph>DXGI_FORMAT_B8G8R8A8_UNORM</codeph>, <codeph>DXGI_FORMAT_B8G8R8A8_TYPELESS</codeph>, and <codeph>DXGI_FORMAT_NV12</codeph>.
                        <note>(screen capture only)</note>
                    </pd>
                </plentry>
            <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_PIXEL_DEFAULT"/></pt>
                    <pd>0: Raw video pixel format.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_PIXEL_I420"/></pt>
                    <pd>1: The format is I420.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_PIXEL_BGRA"/></pt>
                    <pd>2: The format is BGRA.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_PIXEL_NV21"/></pt>
                    <pd>3: The format is NV21.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_PIXEL_RGBA"/></pt>
                    <pd>4: The format is RGBA.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_PIXEL_IMC2"/></pt>
                    <pd>5: The format is IMC2.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_PIXEL_ARGB"/></pt>
                    <pd>7: The format is ARGB.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_PIXEL_NV12"/></pt>
                    <pd>8: The format is NV12.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_TEXTURE_2D"/></pt>
                    <pd>10: The format is TEXTURE_2D.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="AgoraVideoFormatCVPixelNV12"/></pt>
                    <pd>12: The format is CVPixelBufferRef NV12.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="AgoraVideoFormatCVPixelI420"/></pt>
                    <pd>13: The format is CVPixelBufferRef I420.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="AgoraVideoFormatCVPixelBGRA"/></pt>
                    <pd>14: The format is CVPixelBufferRef BGRA.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_PIXEL_I422"/></pt>
                    <pd>16: The format is I422.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_TEXTURE_ID3D11TEXTURE2D"/></pt>
                    <pd>17: The ID3D11TEXTURE2D format. Currently supported types are <codeph>DXGI_FORMAT_B8G8R8A8_UNORM</codeph>, <codeph>DXGI_FORMAT_B8G8R8A8_TYPELESS</codeph> and <codeph>DXGI_FORMAT_NV12</codeph>.</pd>
                </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
</reference>
