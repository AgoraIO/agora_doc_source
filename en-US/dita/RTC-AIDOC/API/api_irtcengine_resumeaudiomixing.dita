<reference id="api_irtcengine_resumeaudiomixing">
    <title><ph keyref="resumeAudioMixing"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Resumes the playback and mixing of the music file.</ph><ph id="shortdesc" props="android">Resumes the playback and audio mixing of the music file.</ph><ph id="shortdesc" props="ios mac">Resumes playing and mixing the music file.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="resumeAudioMixing"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual int resumeAudioMixing() = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">public abstract int resumeAudioMixing();</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (int)resumeAudioMixing;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)resumeAudioMixing NS_SWIFT_NAME(resumeAudioMixing());</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="cpp">After calling <xref keyref="pauseAudioMixing"/> to pause playback, you can call <xref keyref="resumeAudioMixing"/> to resume playback.</p>
            <p props="android">After calling <xref keyref="pauseAudioMixing"/>, you can call <xref keyref="resumeAudioMixing"/> to resume playback.</p>
        <p props="ios mac">After calling <xref keyref="pauseAudioMixing"/> to pause the playback, you can call this method to resume the playback.</p>
        </section>
        <section id="timing" deliveryTarget="details" props="android cpp">
            <title>Timing</title>
            <p props="cpp">Call this method after joining a channel.</p>
            <p props="android">Call this method after joining a channel.</p>
        </section>
        <section id="return_values" props="android cpp ios mac">
            <title>Return Values</title>
            <p props="cpp">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
            <p props="android">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
        <ul props="ios mac">
            <li>0: Success.</li>
            <li>&lt; 0: Failure. <ph props="cn">See <xref keyref="error-code-link"/> for details and resolution suggestions.</ph></li>
            </ul> </section>
    </refbody>
