                </plentry>
                <plentry props="cpp">
                    <pt>event</pt>
                    <pd>Event triggered when preloading media resources, see <xref keyref="PLAYER_PRELOAD_EVENT"/>.</pd>
                </plentry>
                <plentry props="android">
                    <pt>src</pt>
                    <pd>URL of the media resource.</pd>
                </plentry>
                <plentry props="android">
                    <pt>event</pt>
                    <pd>Event that occurred during media resource preloading. See <xref keyref="PLAYER_PRELOAD_EVENT"/>.</pd>
                </plentry>
            <plentry conkeyref="onPlayerEvent/playerkit" props="ios mac">
                <pt/>
                <pd/>
            </plentry>
