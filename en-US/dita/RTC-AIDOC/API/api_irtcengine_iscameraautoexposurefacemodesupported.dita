<reference id="api_irtcengine_iscameraautoexposurefacemodesupported">
    <title><ph keyref="isCameraAutoExposureFaceModeSupported"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Checks whether the device supports auto exposure.</ph><ph id="shortdesc" props="ios mac">Checks whether the device supports auto exposure.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="isCameraAutoExposureFaceModeSupported"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual bool isCameraAutoExposureFaceModeSupported() = 0;</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (BOOL)isCameraAutoExposureFaceModeSupported;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (BOOL)isCameraAutoExposureFaceModeSupported NS_SWIFT_NAME(isCameraAutoExposureFaceModeSupported());</codeblock>
            </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <note props="cpp"><xref keyref="isCameraAutoExposureFaceModeSupported"/> applies to iOS only. You must call this method after the SDK triggers the <xref keyref="onLocalVideoStateChanged"/> callback and returns the local video state as <codeph>LOCAL_VIDEO_STREAM_STATE_CAPTURING</codeph> (1).</note>
        <p props="ios mac">
            <note type="attention">
            <ul>
            <li props="cpp unreal bp unity flutter rn cs">This method applies to iOS only.</li>
            <li conkeyref="isCameraExposureSupported/sequence"/>
            </ul> </note> </p>
        </section>
        <section id="return_values" props="cpp ios mac">
            <title>Return Values</title>
            <p props="cpp"><xref keyref="true"/>: The device supports auto exposure.
<xref keyref="false"/>: The device does not support auto exposure.</p>
        <ul props="ios mac">
            <li><codeph><ph keyref="true"/></codeph>: The device supports auto exposure.</li>
            <li><codeph><ph keyref="false"/></codeph>: The device does not support auto exposure.</li>
            </ul> </section>
    </refbody>
</reference>
