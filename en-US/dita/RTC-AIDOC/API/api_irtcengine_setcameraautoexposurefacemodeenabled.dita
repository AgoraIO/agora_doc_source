<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_irtcengine_setcameraautoexposurefacemodeenabled">
    <title><ph keyref="setCameraAutoExposureFaceModeEnabled"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Sets whether to enable auto exposure.</ph><ph id="shortdesc" props="ios mac">Sets whether to enable auto exposure.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="setCameraAutoExposureFaceModeEnabled"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual int setCameraAutoExposureFaceModeEnabled(bool enabled) = 0;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (BOOL)setCameraAutoExposureFaceModeEnabled:(BOOL)enable NS_SWIFT_NAME(setCameraAutoExposureFaceModeEnabled(_:));</codeblock>
            </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <note props="cpp">This method applies to iOS only. You must call this method after calling <xref keyref="enableVideo"/>. The setting takes effect after the camera is successfully started, that is, when the SDK triggers the <xref keyref="onLocalVideoStateChanged"/> callback and returns the local video state as <codeph>LOCAL_VIDEO_STREAM_STATE_CAPTURING</codeph> (1).</note>
        <p props="ios mac">
            <note type="attention">
            <ul>
            <li props="cpp unreal bp unity flutter rn cs">This method applies to iOS only.</li>
            <li conkeyref="setCameraExposureFactor/sequence"/>
            </ul> </note> </p>
        </section>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>enabled</pt>
                    <pd>Whether to enable auto exposure:
                        <ul>
                            <li><xref keyref="true"/>: Enable auto exposure.</li>
                            <li><xref keyref="false"/>: Disable auto exposure.</li>
                        </ul>
                    </pd>
                </plentry>
            <plentry props="ios mac">
                    <pt props="cpp unreal bp flutter rn unity electron cs">enabled</pt>
                    <pd>
                        <p>Whether to enable auto exposure:<ul>
                        <li><codeph><ph keyref="true"/></codeph>: Enable auto exposure.</li>
                        <li><codeph><ph keyref="false"/></codeph>: Disable auto exposure.</li>
                        </ul></p>
                    </pd>
                </plentry>
                </parml>
        </section>
        <section id="return_values" props="cpp ios mac">
            <title>Return Values</title>
            <p props="cpp">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
        <p props="ios mac">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
        </section>
    </refbody>
</reference>
