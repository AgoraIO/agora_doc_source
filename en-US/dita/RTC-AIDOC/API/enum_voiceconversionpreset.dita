<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_voiceconversionpreset">
    <title><ph keyref="VOICE_CONVERSION_PRESET"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">SDK preset voice conversion options.</ph><ph id="shortdesc" props="ios mac">The options for SDK preset voice conversion effects.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>VOICE_CONVERSION_OFF</pt>
                    <pd>(0x00000000): Disable voice conversion and use the original voice.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_NEUTRAL</pt>
                    <pd>(0x03010100): Neutral tone. To avoid audio distortion, it is recommended for female voices.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_SWEET</pt>
                    <pd>(0x03010200): Sweet tone. To avoid audio distortion, it is recommended for female voices.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_SOLID</pt>
                    <pd>(0x03010300): Deep tone. To avoid audio distortion, it is recommended for male voices.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_BASS</pt>
                    <pd>(0x03010400): Low-pitched tone. To avoid audio distortion, it is recommended for male voices.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_CARTOON</pt>
                    <pd>(0x03010500): Cartoon character tone.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_CHILDLIKE</pt>
                    <pd>(0x03010600): Childlike voice effect.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_PHONE_OPERATOR</pt>
                    <pd>(0x03010700): Phone operator tone.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_MONSTER</pt>
                    <pd>(0x03010800): Monster tone.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_TRANSFORMERS</pt>
                    <pd>(0x03010900): Transformers tone.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_GROOT</pt>
                    <pd>(0x03010A00): Groot tone.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_DARTH_VADER</pt>
                    <pd>(0x03010B00): Darth Vader tone.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_IRON_LADY</pt>
                    <pd>(0x03010C00): Husky female tone.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_SHIN_CHAN</pt>
                    <pd>(0x03010D00): Crayon Shin-chan tone.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_GIRLISH_MAN</pt>
                    <pd>(0x03010E00): Falsetto male tone.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VOICE_CHANGER_CHIPMUNK</pt>
                    <pd>(0x03010F00): Chipmunk tone.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="VOICE_CONVERSION_OFF"/></pt>
                <pd>Turn off voice conversion effects and use the original voice.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="VOICE_CHANGER_NEUTRAL"/></pt>
                <pd>A gender-neutral voice. To avoid audio distortion, ensure that you use this enumerator to process a female-sounding voice.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="VOICE_CHANGER_SWEET"/></pt>
                <pd>A sweet voice. To avoid audio distortion, ensure that you use this enumerator to process a female-sounding voice.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="VOICE_CHANGER_SOLID"/></pt>
                <pd>A steady voice. To avoid audio distortion, ensure that you use this enumerator to process a male-sounding voice.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="VOICE_CHANGER_BASS"/></pt>
                <pd>A deep voice. To avoid audio distortion, ensure that you use this enumerator to process a male-sounding voice.</pd>
            </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
</reference>
