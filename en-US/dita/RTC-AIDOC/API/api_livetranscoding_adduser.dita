<reference id="api_livetranscoding_adduser">
    <title><ph keyref="addUser"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="android">Adds a user displaying the video in CDN live.</ph><ph id="shortdesc" props="ios mac">Adds a user for video mixing during the CDN live streaming.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="addUser"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="android" outputclass="language-java">public int addUser(TranscodingUser user)</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">
- (int)addUser:(AgoraLiveTranscodingUser* _Nonnull)user;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)addUser:(AgoraLiveTranscodingUser* _Nonnull)user NS_SWIFT_NAME(add(_:));</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title"/>
        <section id="parameters" deliveryTarget="details" props="android ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="android">
                    <pt>user</pt>
                    <pd>The transcoding user to add. See <xref keyref="TranscodingUser"/>.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt>user</pt>
                <pd>The transcoding user. See <xref keyref="TranscodingUser"/> for details.</pd>
            </plentry>
            </parml>
        </section>
        <section id="return_values" props="android ios mac">
            <title>Return Values</title>
            <p props="android">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
        <ul props="ios mac">
            <li>0: Success.</li>
            <li>&lt; 0: Failure.</li>
            </ul> </section>
    </refbody>
</reference>
