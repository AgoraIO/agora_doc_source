<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_recorderstreamtype">
    <title><ph keyref="RecorderStreamType"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Type of video stream to record.</ph><ph id="shortdesc" props="ios mac">Type of video stream to record.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>RTC</pt>
                    <pd>(0): Video stream in the channel (default).</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>PREVIEW</pt>
                    <pd>(1): Local preview video stream before joining the channel.</pd>
                </plentry>
            <plentry props="ios mac">
                    <pt>RTC</pt>
                    <pd>(0): Video stream in the channel (default).</pd></plentry>
                <plentry props="ios mac">
                    <pt>PREVIEW</pt>
                    <pd>(1): Local preview video stream before joining the channel.</pd></plentry>
                <plentry props="ios mac">
                    <pt>AgoraRecorderStreamTypeRtc</pt>
                    <pd>(0): (Default) The video stream in the source channel.</pd>
                </plentry>
                <plentry props="ios mac">
                    <pt>AgoraRecorderStreamTypePreview</pt>
                    <pd>(1): The video stream of the local video capture preview before joining the channel.</pd>
                </plentry>
                </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
</reference>
