<reference id="callback_imediaplayersourceobserver_onplayerplaybackstats">
    <title><ph keyref="onPlayerPlaybackStats"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Callback for statistics of the media file being played.</ph><ph id="shortdesc" props="android">Callback reporting statistics of the playing media file.</ph><ph id="shortdesc" props="ios mac">Reports the statistics of the media file being played.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="onPlayerPlaybackStats"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual void onPlayerPlaybackStats(const media::base::PlayerPlaybackStats&amp; stats)</codeblock>
                <codeblock props="android" outputclass="language-java">void onPlayerPlaybackStats(PlayerPlaybackStats stats)</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">(void)AgoraRtcMediaPlayer:(id&lt;AgoraRtcMediaPlayerProtocol&gt; _Nonnull)playerKit playbackStats:(AgoraMediaPlayerPlaybackStats *_Nonnull)info NS_SWIFT_NAME(AgoraRtcMediaPlayer(_:playbackStats:));</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (void)AgoraRtcMediaPlayer:(id&lt;AgoraRtcMediaPlayerProtocol&gt; _Nonnull)playerKit playbackStats:(AgoraMediaPlayerPlaybackStats *_Nonnull)info NS_SWIFT_NAME(AgoraRtcMediaPlayer(_:playbackStats:));</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="cpp">This callback is triggered once per second to report statistics of the media file being played.</p>
            <p props="android">This callback is triggered every second during media file playback.</p>
        <dl outputclass="since"><dlentry props="ios mac">
                <dt>Since</dt>
                <dd>v4.3.0</dd>
            </dlentry>
            </dl><p props="ios mac">The SDK triggers this callback once per second to report the statistics of the media file being played.</p>
        </section>
        <section id="timing" deliveryTarget="details" props="android">
            <title>Trigger Timing</title>
            <p props="android">This callback is triggered every second during media file playback.</p>
        </section>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>stats</pt>
                    <pd>Statistics of the media file. See <xref keyref="PlayerPlaybackStats"/>.</pd>
                </plentry>
                <plentry props="android">
                    <pt>stats</pt>
                    <pd>Statistics of the media file. See <xref keyref="PlayerPlaybackStats"/>.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt props="cpp android hmos framework">stats</pt>
                <pt props="apple">info</pt>
                <pd>The statistics of the media file. See <xref keyref="PlayerPlaybackStats"/>.</pd>
            </plentry>
             <plentry props="ios mac" id="kit">
                 <pt>playerKit</pt>
                 <pd>The <xref keyref="IMediaPlayer"/> instance.</pd>
             </plentry>
            </parml>
        </section>
    </refbody>
</reference>
