            <parml>
                <plentry props="cpp">
                    <pt>muted</pt>
                    <pd>Whether to mute the media file:
                        <ul>
                            <li><xref keyref="true"/>: Mute the media file.</li>
                            <li><xref keyref="false"/>: (Default) Unmute the media file.</li>
                        </ul>
                    </pd>
                </plentry>
                <plentry props="android">
                    <pt>muted</pt>
