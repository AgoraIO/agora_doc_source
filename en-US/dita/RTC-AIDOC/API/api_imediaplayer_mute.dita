<reference id="api_imediaplayer_mute">
    <title><ph keyref="mute"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Sets whether to mute the media file.</ph><ph id="shortdesc" props="android">Sets whether to mute the media file.</ph><ph id="shortdesc" props="ios mac">Sets whether to mute the media file.</ph></shortdesc>
