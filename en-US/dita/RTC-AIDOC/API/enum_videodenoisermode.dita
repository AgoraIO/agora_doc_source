<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_videodenoisermode">
    <title><ph keyref="VIDEO_DENOISER_MODE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Video denoising mode.</ph><ph id="shortdesc" props="ios mac">Video noise reduction mode.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>VIDEO_DENOISER_AUTO</pt>
                    <pd>(0): (Default) Automatic mode. The SDK enables or disables video denoising automatically based on ambient lighting.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>VIDEO_DENOISER_MANUAL</pt>
                    <pd>(1): Manual mode. You need to manually enable or disable video denoising.</pd>
                </plentry>
            <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_DENOISER_AUTO"/></pt>
                    <pd>0: (Default) Automatic mode. The SDK automatically enables or disables the video noise reduction feature according to the ambient light.</pd>
               </plentry>
               <plentry props="ios mac">
                    <pt><ph keyref="VIDEO_DENOISER_MANUAL"/></pt>
                    <pd>1: Manual mode. Users need to enable or disable the video noise reduction feature manually.</pd>
               </plentry>
               </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"><dl outputclass="since"><dlentry props="ios mac">
                    <dt>Since</dt>
                    <dd>Available since v4.0.0.</dd>
                </dlentry>
                </dl></section></refbody>
</reference>
