<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_irtcengine_getaudiomixingpublishvolume">
    <title><ph keyref="getAudioMixingPublishVolume"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Gets the audio mixing volume for publishing.</ph><ph id="shortdesc" props="android">Gets the audio mixing volume for publishing.</ph><ph id="shortdesc" props="ios mac">Retrieves the audio mixing volume for publishing.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="getAudioMixingPublishVolume"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual int getAudioMixingPublishVolume() = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">public abstract int getAudioMixingPublishVolume();</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (int)getAudioMixingPublishVolume;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)getAudioMixingPublishVolume NS_SWIFT_NAME(getAudioMixingPublishVolume());</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="android">This method helps troubleshoot audio volume-related issues.</p>
            <note props="cpp">You need to call this method after calling <codeph>startAudioMixing</codeph> and receiving the <xref keyref="onAudioMixingStateChanged"/> (<codeph>AUDIO_MIXING_STATE_PLAYING</codeph>) callback.</note>
            <note props="android">You need to call this method after calling <codeph>startAudioMixing</codeph> and receiving the <xref keyref="onAudioMixingStateChanged"/> (<codeph>AUDIO_MIXING_STATE_PLAYING</codeph>) callback.</note>
        <p props="ios mac">This method helps troubleshoot audio volume‑related issues.</p>
            <note type="attention" props="ios mac">You need to call this method after calling <xref keyref="startAudioMixing2"/> and receiving the <apiname keyref="onAudioMixingStateChanged"/><codeph>(<ph keyref="AUDIO_MIXING_STATE_PLAYING"/>)</codeph> callback.</note> </section>
        <section id="return_values" props="android cpp ios mac">
            <title>Return Values</title>
            <p props="cpp">
                <ul>
                    <li>0: Success. Returns the audio mixing volume. Range: [0,100].</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
            <p props="android">
                <ul>
                    <li>≥ 0: Success. Returns the audio mixing volume in the range [0, 100].</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
        <ul props="ios mac">
            <li>≥ 0: The audio mixing volume, if this method call succeeds. The value range is [0,100].</li>
            <li>&lt; 0: Failure. <ph props="cn">See <xref keyref="error-code-link"/> for details and resolution suggestions.</ph></li>
            </ul> </section>
    </refbody>
</reference>
