<reference id="api_irtcengine_getdefaultaudiodevice">
    <title><ph keyref="getDefaultAudioDevice"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="ios mac">Gets the system default audio device.</ph><ph id="shortdesc" props="ios mac">Gets the system default audio device.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="getDefaultAudioDevice"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="mac" outputclass="language-objectivec">- (AgoraRtcDeviceInfo* _Nullable)getDefaultAudioDevice:(AgoraMediaDeviceType)type NS_SWIFT_NAME(getDefaultAudioDevice(_:));</codeblock>
            </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title"/>
        <section id="parameters" deliveryTarget="details" props="mac ios">
            <title>Parameters</title>
            <parml>
                <plentry props="mac">
                    <pt>type</pt>
                    <pd>The device type. See AgoraMediaDeviceType.</pd></plentry>
            <plentry props="ios mac">
                    <pt>type</pt>
                    <pd>The device type. See AgoraMediaDeviceType.</pd></plentry>
            </parml>
        </section>
        <section id="return_values" props="mac">
            <title>Return Values</title>
            <p props="ios mac">If the method call succeeds, returns an AgoraRtcDeviceInfo object. If the method call fails, returns nil.</p></section>
    </refbody>
</reference>
