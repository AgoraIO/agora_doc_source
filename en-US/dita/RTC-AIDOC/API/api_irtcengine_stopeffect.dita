<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_irtcengine_stopeffect">
    <title><ph keyref="stopEffect"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Stops playing the specified audio effect.</ph><ph id="shortdesc" props="android">Stops playback of the specified audio effect.</ph><ph id="shortdesc" props="ios mac">Stops playing a specified audio effect.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="stopEffect"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual int stopEffect(int soundId) = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">public abstract int stopEffect(int soundId);</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (int)stopEffect:(int)soundId;
</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)stopEffect:(int)soundId NS_SWIFT_NAME(stopEffect(_:));</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="cpp">Call this method to stop playing the specified audio effect. To pause playback instead, call <xref keyref="pauseEffect"/>.</p>
            <p props="android">If you only need to pause playback, call the <xref keyref="pauseEffect"/> method.</p>
        <p props="ios mac">When you no longer need to play the audio effect, you can call this method to stop the playback. If you only need to pause the playback, call <xref keyref="pauseEffect"/>.</p>
        </section>
        <section id="timing" deliveryTarget="details" props="android cpp">
            <title>Timing</title>
            <p props="cpp">Call this method after calling <xref keyref="playEffect3"/>.</p>
            <p props="android">Call after <codeph>playEffect</codeph>.</p>
        </section>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>soundId</pt>
                    <pd>The ID of the audio effect. Each audio effect has a unique ID.</pd>
                </plentry>
                <plentry props="android">
                    <pt>soundId</pt>
                    <pd>The ID of the audio effect. Each audio effect has a unique ID.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt>soundId</pt>
                <pd>The ID of the audio effect. Each audio effect has a unique ID.</pd>
            </plentry>
            </parml>
        </section>
        <section id="return_values" props="android cpp ios mac">
            <title>Return Values</title>
            <p props="cpp">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
            <p props="android">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
        <ul props="ios mac">
            <li>0: Success.</li>
            <li>&lt; 0: Failure. <ph props="cn">See <xref keyref="error-code-link"/> for details and resolution suggestions.</ph></li>
            </ul> </section>
    </refbody>
</reference>
