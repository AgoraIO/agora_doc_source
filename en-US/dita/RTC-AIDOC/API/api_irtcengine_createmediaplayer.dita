<reference id="api_irtcengine_createmediaplayer">
    <title><ph keyref="createMediaPlayer"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Creates an <xref keyref="IMediaPlayer"/> object.</ph><ph id="shortdesc" props="android">Creates an <xref keyref="IMediaPlayer"/> object.</ph><ph id="shortdesc" props="ios mac">Creates a media player instance.</ph></shortdesc>
