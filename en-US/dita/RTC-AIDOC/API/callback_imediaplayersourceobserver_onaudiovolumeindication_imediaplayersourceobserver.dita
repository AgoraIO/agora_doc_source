<reference id="callback_imediaplayersourceobserver_onaudiovolumeindication_imediaplayersourceobserver">
    <title><ph keyref="onAudioVolumeIndication_IMediaPlayerSourceObserver"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Callback that reports the media player volume.</ph><ph id="shortdesc" props="android">Callback reporting the media player's volume.</ph><ph id="shortdesc" props="ios mac">Reports the volume of the media player.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="onAudioVolumeIndication_IMediaPlayerSourceObserver"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="cpp" outputclass="language-cpp">virtual void onAudioVolumeIndication(int volume) = 0;</codeblock>
                <codeblock props="android" outputclass="language-java">@CalledByNative void onAudioVolumeIndication(int volume);</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (void)AgoraRtcMediaPlayer:(id&lt;AgoraRtcMediaPlayerProtocol&gt; _Nonnull)playerKit
             volumeIndicationDidReceive:(NSInteger)volume;
</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (void)AgoraRtcMediaPlayer:(id&lt;AgoraRtcMediaPlayerProtocol&gt; _Nonnull)playerKit
             volumeIndicationDidReceive:(NSInteger)volume NS_SWIFT_NAME(AgoraRtcMediaPlayer(_:volumeIndicationDidReceive:));</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="cpp">This callback is triggered every 200 milliseconds.</p>
            <p props="android">This callback is triggered every 200 milliseconds.</p>
        <p props="ios mac">The SDK triggers this callback every 200 milliseconds to report the current volume of the media player.</p>
        </section>
        <section id="timing" deliveryTarget="details" props="android">
            <title>Trigger Timing</title>
            <p props="android">This callback is triggered every 200 milliseconds to report the current volume of the media player.</p>
        </section>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="cpp">
                    <pt>volume</pt>
                    <pd>Volume of the media player, ranging from 0 to 255.</pd>
                </plentry>
                <plentry props="android">
                    <pt>volume</pt>
                    <pd>Volume of the media player, ranging from 0 to 255.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt>volume</pt>
                <pd>The volume of the media player. The value ranges from 0 to 255.</pd>
            </plentry>
            </parml>
        </section>
    </refbody>
