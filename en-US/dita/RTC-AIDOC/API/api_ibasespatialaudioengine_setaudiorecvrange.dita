<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="api_ibasespatialaudioengine_setaudiorecvrange">
    <title><ph keyref="setAudioRecvRange"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="android">Sets the local user’s audio reception range.</ph><ph id="shortdesc" props="ios mac">Sets the audio reception range of the local user.</ph></shortdesc>
    <prolog>
        <metadata>
            <keywords>
                <indexterm keyref="setAudioRecvRange"/>
            </keywords>
        </metadata>
    </prolog>
    <refbody>
        <section id="prototype">
            <p outputclass="codeblock">
                <codeblock props="android" outputclass="language-java">public abstract int setAudioRecvRange(float range);</codeblock>
            <codeblock props="ios mac" outputclass="language-objectivec">- (int)setAudioRecvRange:(float)range;</codeblock>
            <codeblock props="ios" outputclass="language-objectivec">- (int)setAudioRecvRange:(float)range NS_SWIFT_NAME(setAudioRecvRange(_:));</codeblock>
                </p>
        </section>
        <section id="detailed_desc" deliveryTarget="details" otherprops="no-title">
            <p props="android">You can call this method at any time to update the audio reception range. After setting it successfully, the local user can only receive audio from remote users within the specified range or on the same team.</p>
        <p props="ios mac">After the setting is successful, the local user can only hear the remote users within the setting range or belonging to the same team. You can call this method at any time to update the audio reception range.</p>
            </section>
        <section id="parameters" deliveryTarget="details" props="android ios mac">
            <title>Parameters</title>
            <parml>
                <plentry props="android">
                    <pt>range</pt>
                    <pd>Maximum audio reception range in meters. The value must be greater than 0. (Default is 20)</pd>
                </plentry>
            <plentry props="ios mac">
                <pt>range</pt>
                <pd>The maximum audio reception range. The unit is meters. The value of this parameter must be greater than 0, and the default value is 20.</pd>
            </plentry>
            </parml>
        </section>
        <section id="return_values" props="android ios mac">
            <title>Return Values</title>
            <p props="android">
                <ul>
                    <li>0: Success.</li>
                    <li>&lt; 0: Failure.</li>
                </ul>
            </p>
        <ul props="ios mac">
            <li>0: Success.</li>
            <li>&lt; 0: Failure. <ph props="cn">See <xref keyref="error-code-link"/> for details and resolution suggestions.</ph></li>
            </ul> </section>
    </refbody>
</reference>
