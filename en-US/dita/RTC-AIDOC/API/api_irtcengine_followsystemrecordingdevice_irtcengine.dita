<reference id="api_irtcengine_followsystemrecordingdevice_irtcengine">
    <title><ph keyref="followSystemRecordingDevice_IRtcEngine"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="ios mac">Sets whether the SDK audio recording device follows the system default audio recording device.</ph><ph id="shortdesc" props="ios mac">Sets whether the SDK audio recording device follows the system default audio recording device.</ph></shortdesc>
