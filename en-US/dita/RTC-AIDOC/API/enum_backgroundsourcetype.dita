<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_backgroundsourcetype">
    <title><ph keyref="BACKGROUND_SOURCE_TYPE"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Custom background type.</ph><ph id="shortdesc" props="ios mac">The custom background.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>BACKGROUND_NONE</pt>
                    <pd>(0): Treats the background as alpha data without replacement, only separating the portrait from the background. After setting this value, you can call <xref keyref="startLocalVideoTranscoder"/> to achieve picture-in-picture effects.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>BACKGROUND_COLOR</pt>
                    <pd>(1): (Default) The background is a solid color image.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>BACKGROUND_IMG</pt>
                    <pd>(2): The background is an image in PNG or JPG format.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>BACKGROUND_BLUR</pt>
                    <pd>(3): The background is a blurred version of the original background.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>BACKGROUND_VIDEO</pt>
                    <pd>(4): The background is a local video, supporting formats such as MP4, AVI, MKV, FLV, etc.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="BACKGROUND_NONE"/></pt>
                <pd>0: Process the background as alpha data without replacement, only separating the portrait and the background. After setting this value, you can call <xref keyref="startLocalVideoTranscoder"/> to implement the picture-in-picture effect.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="BACKGROUND_COLOR"/></pt>
                <pd>1: (Default) The background image is a solid color.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="BACKGROUND_IMG"/></pt>
                <pd>2: The background is an image in PNG or JPG format.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="BACKGROUND_BLUR"/></pt>
                <pd>3: The background is a blurred version of the original background.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="BACKGROUND_VIDEO"/></pt>
                <pd>4: The background is a local video in MP4, AVI, MKV, FLV, or other supported formats.</pd>
            </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"><dl outputclass="since"><dlentry props="ios mac">
                    <dt>Since</dt>
                    <dd>Available since v3.7.200.</dd>
                </dlentry>
                </dl></section></refbody>
</reference>
