    <shortdesc id="short"><ph id="shortdesc" props="cpp">Callback for uplink and downlink last-mile network probe results.</ph><ph id="shortdesc" props="android">Callback for uplink and downlink Last-mile network probe test results.</ph><ph id="shortdesc" props="ios mac">Reports the last mile network probe result.</ph></shortdesc>
