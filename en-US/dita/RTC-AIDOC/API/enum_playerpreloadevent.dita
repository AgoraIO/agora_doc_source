<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="enum_playerpreloadevent">
    <title><ph keyref="PLAYER_PRELOAD_EVENT"/></title>
    <shortdesc id="short"><ph id="shortdesc" props="cpp">Events during media preloading.</ph><ph id="shortdesc" props="android">Events during media resource preloading.</ph><ph id="shortdesc" props="ios mac">Events that occur when media resources are preloaded.</ph></shortdesc>
    <refbody>
        <section id="parameters" deliveryTarget="details" props="android cpp ios mac">
            <title>Enumerations</title>
            <parml>
                <plentry props="cpp">
                    <pt>PLAYER_PRELOAD_EVENT_BEGIN</pt>
                    <pd>(0): Start preloading media.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>PLAYER_PRELOAD_EVENT_COMPLETE</pt>
                    <pd>(1): Media preloading completed.</pd>
                </plentry>
                <plentry props="cpp">
                    <pt>PLAYER_PRELOAD_EVENT_ERROR</pt>
                    <pd>(2): Error occurred during media preloading.</pd>
                </plentry>
                <plentry props="android">
                    <pt>PLAYER_PRELOAD_EVENT_BEGIN</pt>
                    <pd>(0): Start preloading media resource.</pd>
                </plentry>
                <plentry props="android">
                    <pt>PLAYER_PRELOAD_EVENT_COMPLETE</pt>
                    <pd>(1): Media resource preloading completed.</pd>
                </plentry>
                <plentry props="android">
                    <pt>PLAYER_PRELOAD_EVENT_ERROR</pt>
                    <pd>(2): Error occurred during media resource preloading.</pd>
                </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="PLAYER_PRELOAD_EVENT_BEGIN"/></pt>
                <pd>0: Starts preloading media resources.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="PLAYER_PRELOAD_EVENT_COMPLETE"/></pt>
                <pd>1: Preloading media resources is complete.</pd>
            </plentry>
            <plentry props="ios mac">
                <pt><ph keyref="PLAYER_PRELOAD_EVENT_ERROR"/></pt>
                <pd>2: An error occurs when preloading media resources.</pd>
            </plentry>
            </parml>
        </section>
    <section id="prototype"><p outputclass="codeblock"/></section><section id="detailed_desc"/></refbody>
</reference>
